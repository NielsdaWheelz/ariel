[Unit]
Description=Agency daemon for Ariel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ariel
Group=ariel
WorkingDirectory=/opt/agency
StateDirectory=agency
Environment=AGENCY_DATA_DIR=/var/lib/agency
Environment=HOME=/var/lib/agency
Environment=CODEX_HOME=/var/lib/agency/.codex
ExecStart=/opt/agency/bin/agency daemon start --foreground
Restart=always
RestartSec=5
SyslogIdentifier=agency-daemon
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadWritePaths=/var/lib/agency

[Install]
WantedBy=multi-user.target
