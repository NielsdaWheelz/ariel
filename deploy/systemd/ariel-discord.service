[Unit]
Description=Ariel Discord surface bot
After=network-online.target ariel-api.service
Wants=network-online.target ariel-api.service

[Service]
Type=simple
User=ariel
Group=ariel
WorkingDirectory=/opt/ariel
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/ariel/ariel.env
ExecStart=/opt/ariel/.venv/bin/python -m ariel.discord_bot
Restart=always
RestartSec=5
SyslogIdentifier=ariel-discord

[Install]
WantedBy=multi-user.target
