[Unit]
Description=Ariel durable background worker
After=network-online.target postgresql.service ariel-api.service
Wants=network-online.target postgresql.service ariel-api.service

[Service]
Type=simple
User=ariel
Group=ariel
WorkingDirectory=/opt/ariel
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/ariel/ariel.env
ExecStart=/opt/ariel/.venv/bin/python -m ariel.worker
Restart=always
RestartSec=5
SyslogIdentifier=ariel-worker
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
