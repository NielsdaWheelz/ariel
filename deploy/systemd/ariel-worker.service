[Unit]
Description=Ariel durable background worker
After=network-online.target docker.service ariel-api.service
Wants=network-online.target docker.service ariel-api.service

[Service]
Type=simple
User=ariel
Group=ariel
WorkingDirectory=/opt/ariel
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/ariel/ariel.env
ExecStart=/opt/ariel/.venv/bin/python -m ariel.worker
Restart=always
RestartSec=5
SyslogIdentifier=ariel-worker

[Install]
WantedBy=multi-user.target
