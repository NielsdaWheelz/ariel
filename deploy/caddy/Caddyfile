{
	email niels@trysolid.com
}

ariel.nielseriknandal.com {
	log {
		output file /var/log/caddy/ariel-webhook.log {
			roll_size 50mb
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
			}
			wrap json
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@googleProviderEvents {
		method POST
		path /v1/providers/google/events
	}
	handle @googleProviderEvents {
		reverse_proxy 127.0.0.1:8000
	}

	@googleConnectorCallback {
		method GET
		path /v1/connectors/google/callback
	}
	handle @googleConnectorCallback {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		respond 404
	}
}
