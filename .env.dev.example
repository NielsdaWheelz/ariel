# Template for an isolated local dev environment.
#
# Copy to `.env.dev` (gitignored), then run `make dev-up && make dev-upgrade`
# and any of `make dev-api`, `make dev-worker`, `make dev-discord` to launch
# services against the dev DB on 127.0.0.1:5435.
#
# Every dev-* Make target sets ARIEL_ENV_FILE=.env.dev so the app, dev_db
# helper, and alembic read only this file (not `.env.local`, which systemd
# reads for production). Running `make dev-*` therefore does not affect the
# prod DB (`ariel-postgres` on :5433) or the running prod systemd services.
#
# Runtime config and dev helpers. Env prefix: ARIEL_.

# Dev Postgres — different port and container name from prod so both can run
# side by side. The container is `ariel-postgres-dev` on 127.0.0.1:5435; the
# DB user/password/db can be anything because the container is local-only.
ARIEL_DATABASE_URL=postgresql+psycopg://ariel:dev-only-password@127.0.0.1:5435/ariel
ARIEL_DEPLOYMENT_MODE=development
ARIEL_BIND_HOST=127.0.0.1
# Dev API listens on 8001 so it can coexist with the prod systemd API on 8000.
ARIEL_BIND_PORT=8001
# Loopback dev API does not need auth.
ARIEL_LOCAL_AUTH_REQUIRED=false

# Dev Postgres container helper — names a parallel container/volume so prod
# (`ariel-postgres`) is never touched.
ARIEL_DB_CONTAINER_NAME=ariel-postgres-dev
ARIEL_DB_DOCKER_IMAGE=pgvector/pgvector:pg16
ARIEL_DB_VOLUME_NAME=ariel-postgres-dev-data

# Required for any real model call. Reuse your existing key or use a separate
# dev key — both work; the dev env keeps its own conversation history regardless.
ARIEL_OPENAI_API_KEY=
ARIEL_MODEL_NAME=gpt-5.5
ARIEL_MODEL_REASONING_EFFORT=medium
ARIEL_MODEL_VERBOSITY=low

# Memory embedding provider.
ARIEL_MEMORY_EMBEDDING_PROVIDER=openai
ARIEL_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
ARIEL_MEMORY_EMBEDDING_DIMENSIONS=1536

# Dev connector secret. Safe to use the dev default here because
# ARIEL_DEPLOYMENT_MODE=development.
ARIEL_CONNECTOR_ENCRYPTION_SECRET=dev-local-connector-secret
ARIEL_CONNECTOR_ENCRYPTION_KEY_VERSION=v1

# Discord — leave unset to skip the surface entirely, or paste a *different*
# bot token from prod so the dev bot answers in a separate channel/guild and
# does not double-respond to user DMs that the prod bot already serves.
# ARIEL_DISCORD_BOT_TOKEN=
# ARIEL_DISCORD_GUILD_ID=
# ARIEL_DISCORD_CHANNEL_ID=
# ARIEL_DISCORD_USER_ID=
ARIEL_DISCORD_ARIEL_BASE_URL=http://127.0.0.1:8001
ARIEL_DISCORD_NOTIFICATION_TIMEOUT_SECONDS=10.0

# Google connector — point OAuth at the dev port if you exercise the flow.
# ARIEL_GOOGLE_OAUTH_CLIENT_ID=
# ARIEL_GOOGLE_OAUTH_CLIENT_SECRET=
ARIEL_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/v1/connectors/google/callback

# Worker / subscriber.
ARIEL_WORKER_POLL_SECONDS=1.0
ARIEL_SUBSCRIBER_HEARTBEAT_INTERVAL_SECONDS=30.0
ARIEL_SUBSCRIBER_HEARTBEAT_STALENESS_FACTOR=2.0
ARIEL_PROVIDER_RECONCILE_SYNC_INTERVAL_SECONDS=3600

# Provider capability keys — populate the ones you intend to exercise in dev.
# ARIEL_SEARCH_WEB_API_KEY=
# ARIEL_MAPS_API_KEY=
# ARIEL_WEATHER_PRODUCTION_API_KEY=
